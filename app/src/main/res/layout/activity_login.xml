<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06235F">

    <!-- LockBox Logo -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/lockbox_logo"
        android:scaleType="fitCenter"
        android:contentDescription="LockBox Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your master PIN"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- PIN -->
    <EditText
        android:id="@+id/etPin"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:hint="Enter PIN"
        android:textColor="#FFFFFF"
        android:textColorHint="#E0A928"
        android:textSize="18sp"
        android:inputType="numberPassword"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:background="@drawable/pin_edittext"
        android:drawableEnd="@drawable/ic_visibility_off"
        android:drawablePadding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        android:layout_marginTop="45dp" />

    <!-- Unlock Button -->
    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:text="Unlock"
        android:textColor="#111111"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="#FFB000"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/etPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        android:layout_marginTop="35dp" />

</androidx.constraintlayout.widget.ConstraintLayout>