<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06235F"
    tools:context=".MainActivity">

    <!-- LockBox Logo -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/lockbox_logo"
        android:scaleType="fitCenter"
        android:contentDescription="LockBox Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="55dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set your master PIN"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp" />

    <!-- Create PIN -->
    <EditText
        android:id="@+id/etCreatePin"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:hint="Create PIN"
        android:textColor="#FFFFFF"
        android:textColorHint="#E0A928"
        android:textSize="18sp"
        android:inputType="numberPassword"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:background="@drawable/pin_edittext"
        android:drawableEnd="@drawable/ic_visibility_off"
        android:drawablePadding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        android:layout_marginTop="45dp" />

    <!-- Confirm PIN -->
    <EditText
        android:id="@+id/etConfirmPin"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:hint="Confirm PIN"
        android:textColor="#FFFFFF"
        android:textColorHint="#E0A928"
        android:textSize="18sp"
        android:inputType="numberPassword"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:background="@drawable/pin_edittext"
        android:drawableEnd="@drawable/ic_visibility_off"
        android:drawablePadding="10dp"
        app:layout_constraintTop_toBottomOf="@id/etCreatePin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        android:layout_marginTop="20dp" />

    <!-- Set PIN Button -->
    <Button
        android:id="@+id/btnSetPin"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:text="Set PIN"
        android:textColor="#111111"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="#FFB000"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/etConfirmPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        android:layout_marginTop="35dp" />

    <!-- Restore Backup Button -->
    <Button
        android:id="@+id/btnRestoreBackup"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:text="↶  Restore Backup"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#287BE8"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/btnSetPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        android:layout_marginTop="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>